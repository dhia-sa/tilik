# Salin ke .env (opsional — semua punya nilai default). JANGAN isi nilai rahasia di file ini.

# Alamat server (buka di browser)
BIND_ADDR=127.0.0.1:8080

# Database SQLite. Default: <repo>/data/spendview.db (dibuat otomatis)
# DATABASE_URL=sqlite://./data/spendview.db?mode=rwc

# Isi otomatis data dummy 12 bulan dari folder seed/ saat database masih kosong
SEED_ON_START=true

# Provider AI: claude | codex | mock
#  - claude: memanggil `claude -p ... --output-format json --json-schema ... --tools ""` (Claude Code CLI yang sudah login)
#  - codex : memanggil `codex exec --skip-git-repo-check -s read-only --output-schema ... -o ...`
#  - mock  : tanpa AI (aturan kata kunci + ringkasan template), untuk test / kalau CLI tidak ada
# Kalau CLI tidak ditemukan saat start, aplikasi otomatis memakai mock (kecuali AI_STRICT=true).
AI_PROVIDER=claude
AI_STRICT=false

# Path binary CLI (kalau tidak ada di PATH). Windows: mis. C:\Users\nama\.local\bin\claude.exe
CLAUDE_BIN=claude
CODEX_BIN=codex

# Batas waktu per panggilan CLI (detik) dan jumlah proses CLI paralel
AI_TIMEOUT_SECS=120
AI_MAX_PARALLEL=2

# Tanggal acuan "hari ini" (YYYY-MM-DD). Kosong = tanggal PO terakhir di data (2026-11-14 untuk seed)
REFERENCE_DATE=

# Set true kalau dijalankan di balik HTTPS
COOKIE_SECURE=false

# Lokasi hasil build frontend & folder seed (default relatif ke repo)
# FRONTEND_DIST=./frontend/dist
# SEED_DIR=./seed

# Level log
RUST_LOG=spendview=info,tower_http=warn
